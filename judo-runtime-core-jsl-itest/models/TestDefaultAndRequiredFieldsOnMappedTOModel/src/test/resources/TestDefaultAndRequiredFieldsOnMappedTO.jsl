model TestDefaultAndRequiredFieldsOnMappedTO;

import judo::types;

type numeric Scaled precision:9 scale:2;
type string PhoneNumber min-size:0 max-size:32 regex:"^(\\+\\d{1,2})[\\s.-]?(\\d{1,3})?[\\s.-]\\d{3}[\\s.-]\\d{3,4}$";
type binary Binary mime-type:["text/plain"] max-file-size:1 GB;
type string SmallString min-size:0 max-size:128;

enum Enum {
    EnumA = 0;
    EnumB = 1;
    EnumC = 2;
}

////////////////////////////////////////////////////////////////////////////////////////
// Entity with optional fields                                                        //
////////////////////////////////////////////////////////////////////////////////////////

entity EntityWithOptionalFieldsContainer {
    field EntityWithOptionalFields entityWithOptionalFieldsComposition;
    relation EntityWithOptionalFields entityWithOptionalFieldsAssociation;
}

entity EntityWithOptionalFields {
        field Integer integerAttr;
        field Scaled scaledAttr;
        field SmallString stringAttr;
        field PhoneNumber regexAttr;
        field Boolean boolAttr;
        field Date dateAttr;
        field Timestamp timestampAttr;
        field Time timeAttr;
        field Enum enumAttr;
}

// Mapped Transfer Object with optional fields
transfer TransferWithOptionalFieldsMapsEntityWithOptionalFields (EntityWithOptionalFields mappedEntity) {
    field Integer intAttr <=> mappedEntity.integerAttr;
    field Scaled scaledAttr <=> mappedEntity.scaledAttr;
    field SmallString stringAttr <=> mappedEntity.stringAttr;
    field PhoneNumber regexAttr <=> mappedEntity.regexAttr;
    field Boolean boolAttr <=> mappedEntity.boolAttr;
    field Date dateAttr <=> mappedEntity.dateAttr;
    field Timestamp timestampAttr <=> mappedEntity.timestampAttr;
    field Time timeAttr <=> mappedEntity.timeAttr;
    field Enum enumAttr <=> mappedEntity.enumAttr;

    event create onCreate;
}

transfer TransferWithOptionalFieldsMapsEntityWithOptionalFieldsContainer(EntityWithOptionalFieldsContainer mappedEntity) {
    relation TransferWithOptionalFieldsMapsEntityWithOptionalFields entityWithOptionalFieldsCompositionAggregation <= mappedEntity.entityWithOptionalFieldsComposition eager create;
    relation TransferWithOptionalFieldsMapsEntityWithOptionalFields entityWithOptionalFieldsAssociationAssociation <= mappedEntity.entityWithOptionalFieldsAssociation create;
}

// Mapped Transfer Object with optional fields with default
transfer TransferWithOptionalFieldsWithDefaultMapsEntityWithOptionalFields(EntityWithOptionalFields mappedEntity) {
    field Integer intAttr <=> mappedEntity.integerAttr  default:1;
    field Scaled scaledAttr <=> mappedEntity.scaledAttr  default:2.34;
    field SmallString stringAttr <=> mappedEntity.stringAttr  default:"Hello there";
    field PhoneNumber regexAttr <=> mappedEntity.regexAttr  default:"+36 30 123 1234";
    field Boolean boolAttr <=> mappedEntity.boolAttr  default:true;
    field Date dateAttr <=> mappedEntity.dateAttr  default:`2022-07-11`;
    field Timestamp timestampAttr <=> mappedEntity.timestampAttr  default:`2022-07-11T19:09:33Z`;
    field Time timeAttr <=> mappedEntity.timeAttr  default:`23:59:59`;
    field Enum enumAttr <=> mappedEntity.enumAttr  default:Enum#EnumA;
    
    event create onCreate;
}

transfer TransferWithOptionalFieldsWithDefaultMapsEntityWithOptionalFieldsContainer(EntityWithOptionalFieldsContainer mappedEntity) {
    relation TransferWithOptionalFieldsWithDefaultMapsEntityWithOptionalFields entityWithOptionalFieldsCompositionAggregation <= mappedEntity.entityWithOptionalFieldsComposition eager create;
    relation TransferWithOptionalFieldsWithDefaultMapsEntityWithOptionalFields entityWithOptionalFieldsAssociationAssociation <= mappedEntity.entityWithOptionalFieldsAssociation create;
}

// Mapped Transfer Object with optional fields with default expression
transfer TransferWithOptionalFieldsWithDefaultExpressionMapsEntityWithOptionalFields (EntityWithOptionalFields mappedEntity) {
    field SmallString stringAttr <=> mappedEntity.stringAttr  default:queryStringAttribute();
    
    event create onCreate;
}

transfer TransferWithOptionalFieldsWithDefaultExpressionMapsEntityWithOptionalFieldsContainer(EntityWithOptionalFieldsContainer mappedEntity) {
    relation TransferWithOptionalFieldsWithDefaultExpressionMapsEntityWithOptionalFields entityWithOptionalFieldsCompositionAggregation <= mappedEntity.entityWithOptionalFieldsComposition eager create;
    relation TransferWithOptionalFieldsWithDefaultExpressionMapsEntityWithOptionalFields entityWithOptionalFieldsAssociationAssociation <= mappedEntity.entityWithOptionalFieldsAssociation create;
}

