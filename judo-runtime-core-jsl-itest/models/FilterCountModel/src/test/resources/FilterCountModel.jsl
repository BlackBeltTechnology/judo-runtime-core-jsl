model FilterCountModel;

import judo::types;

// Filter Count Test

entity ParentA {
    field String ancestorName;
    relation B ancestorB;
    field String ancestorBName <= self.ancestorB.name;
}

entity A extends ParentA {
    field String name;
    field Integer numb;
    relation C[] cs;
    relation C c;
    field String bname <= self.ancestorB.name;
    field Integer sum <= self.cs.sum(c | c.num);
    field Integer cnum <= self.c.num;
    relation C earliestC <= self.cs.first(c | c.d.date).any();
    relation C latestC <= self.cs.last(c | c.d.date).any();
}

entity B {
    field String name;
    field Integer num;
}

entity C {
    field Integer num;
    field D d;
}

entity D {
    field Date date;
}

// size after navigation

entity Parent {
    field String name;
    field Child[] children;
}

entity Child {
    field String name;
    relation Toy[] toys;
}

entity Toy {
    field String name;
}

entity ExpressionContainer {
    field Integer numberOfChildren <= Parent.all().children.size(); // sql error during runtime
    //field Integer numberOfToys <= Parent.all().children.toys.size(); // check after fix
}
