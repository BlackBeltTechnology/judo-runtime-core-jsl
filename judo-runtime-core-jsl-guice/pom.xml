<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>hu.blackbelt.judo.runtime</groupId>
        <artifactId>judo-runtime-core-jsl-parent</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>judo-runtime-core-jsl-guice</artifactId>
    <packaging>bundle</packaging>

    <name>JUDO Runtime Core :: JUDO Language Specification DSL guice</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                        <Export-Package>hu.blackbelt.judo.runtime.core.guice.jsl.*;version=${project.version}</Export-Package>
                    </instructions>
                </configuration>
            </plugin>
            <!-- split-etl-artifacts 7.1: the ETL add-ons are test-scoped; the "add-ons absent" case runs in its own
                 execution with them removed from the test classpath. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- Plugin-level, so it also applies to a bare `mvn surefire:test` (default-cli), which CI runs for
                     the PostgreSQL pass. The add-on-absent test runs only in its own execution below.
                     See change: split-etl-artifacts. -->
                <configuration>
                    <excludes>
                        <exclude>**/JSLTransformationModelLoaderEtlAbsentTest.java</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>etl-addons-absent</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/JSLTransformationModelLoaderEtlAbsentTest.java</include>
                            </includes>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-jsl-jsl2psm-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-jsl-jsl2ui-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-psm2asm-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-psm2measure-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-asm2rdbms-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-asm2keycloak-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-rdbms2liquibase-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-psm-validation-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-asm-validation-etl</classpathDependencyExclude>
                                <classpathDependencyExclude>hu.blackbelt.judo.tatami:judo-tatami-expression-asm-validation-etl</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself.-->
                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>
                                            org.codehaus.mojo
                                        </groupId>
                                        <artifactId>
                                            flatten-maven-plugin
                                        </artifactId>
                                        <versionRange>
                                            [1.1.0,)
                                        </versionRange>
                                        <goals>
                                            <goal>flatten</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <dependency>
            <groupId>javax.validation</groupId>
            <artifactId>validation-api</artifactId>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.judo</groupId>
            <artifactId>judo-dao-api</artifactId>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.mapper</groupId>
            <artifactId>mapper-api</artifactId>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.judo.runtime</groupId>
            <artifactId>judo-runtime-core-guice</artifactId>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.judo.tatami</groupId>
            <artifactId>judo-tatami-jsl-jsl2psm</artifactId>
        </dependency>

        <dependency>
            <groupId>hu.blackbelt.judo.tatami</groupId>
            <artifactId>judo-tatami-jsl-workflow</artifactId>
        </dependency>

        <!-- ETL add-ons for the judo.transformation.mode=ETL loader tests (split-etl-artifacts 7.1) -->
        <dependency>
            <groupId>hu.blackbelt.judo.tatami</groupId>
            <artifactId>judo-tatami-jsl-workflow-etl</artifactId>
            <type>pom</type>
            <scope>test</scope>
        </dependency>

    </dependencies>
</project>
